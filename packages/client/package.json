{
  "name": "@nexusrtc/client",
  "version": "1.0.0",
  "description": "Framework-agnostic TypeScript Client SDK for NexusRTC (React, Vue, Vanilla, Flutter webview)",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --format=iife --global-name=NexusRTC --outfile=../../apps/laravel-demo/public/js/nexusrtc.bundle.js",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@nexusrtc/core": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
